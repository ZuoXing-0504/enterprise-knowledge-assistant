APP_NAME=Enterprise Knowledge Base Assistant
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/knowledge_base

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# OpenAI-compatible API. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_SECONDS=0.5
OPENAI_EMBEDDING_SEND_DIMENSIONS=false
OPENAI_CHAT_MAX_TOKENS=1000
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.2
RAG_MAX_CONTEXT_CHARS=12000
CITATION_EXCERPT_CHARS=240
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
EMBEDDING_CACHE_TTL_SECONDS=3600

# Optional estimated usage cost for the configured chat model.
MODEL_INPUT_COST_PER_1M_TOKENS=0
MODEL_OUTPUT_COST_PER_1M_TOKENS=0
